APP_ENV=development
APP_ADDR=:8080
APP_SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info
MIGRATIONS_DIR=/app/db/migrations

POSTGRES_DB=poisk
POSTGRES_USER=poisk
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

MANTICORE_HOST=manticore
MANTICORE_HTTP_PORT=9308
MANTICORE_SQL_PORT=9306

# API load protection
API_REQUEST_DEADLINE=3s
API_MAX_CONCURRENT=64
SEARCH_BACKEND_MAX_CONCURRENT=32
API_RATE_PER_SECOND=10
API_RATE_BURST=20
API_RATE_MAX_CLIENTS=10000
API_RATE_IDLE_TTL=10m

# Admin hardening. Required in production; generate exactly 32 random bytes and base64-encode them.
ADMIN_SECRET_KEY_B64=
ADMIN_SESSION_TTL=12h
ADMIN_ACTOR=operator

# Resource pressure monitor. Heavy leases stop at CRITICAL; Search remains available.
RESOURCE_DISK_PATH=/data-watch
RESOURCE_DISK_WARN_PERCENT=85
RESOURCE_DISK_CRITICAL_PERCENT=92
RESOURCE_MEMORY_WARN_PERCENT=85
RESOURCE_MEMORY_CRITICAL_PERCENT=93
RESOURCE_MONITOR_INTERVAL=15s

# Immutable release images. Production release scripts export these from the release registry.
BACKEND_IMAGE=poisk/backend:local
FRONTEND_IMAGE=poisk/frontend:local
RELEASE_ACTOR=operator
RELEASE_VERSION=dev

# Self-hosted immutable PMTiles/style artifacts. Compose mounts ./data/maps here.
MAP_ARTIFACT_ROOT=/maps
# Audit actor used by mapctl register/activate/rollback commands.
MAP_ACTOR=operator

# Organization imports are operator-only files mounted read-only by Compose.
ORG_IMPORT_ROOT=/imports
# Actor written to organization review/import audit events.
ORG_ACTOR=operator

# GAR/FIAS XML files are mounted read-only and can only be read through addressctl.
ADDRESS_IMPORT_ROOT=/address-imports

# First-party Mail Core blob storage.
MAIL_BLOB_DIR=/mail-blobs

# Internet Mail is OFF by default. Enable only after deploy/mail readiness checks pass.
MAIL_INTERNET_ENABLED=false
# Public mail domain used for first-party aliases, SPF/DMARC/DKIM checks and recipient validation.
MAIL_DOMAIN=
# HTTPS endpoint of the private MTA bridge. The Go application never connects to arbitrary browser-supplied relays.
# Example inside a private network: https://mta-bridge.internal:8443
MAIL_MTA_BASE_URL=
# Shared HMAC secret used in both directions. Generate at least 32 random bytes and keep it server-side only.
MAIL_GATEWAY_SHARED_SECRET=
# DKIM selector and expected public TXT value. The PRIVATE key belongs only to the MTA boundary and is never stored here.
MAIL_DKIM_SELECTOR=poisk1
MAIL_DKIM_PUBLIC_TXT=
# The MTA host should mount its DKIM private key from a secret/file, e.g. /run/secrets/mail_dkim_private_key.
# Do not place private-key material in this env file or PostgreSQL.

# Browser uses same-origin /api/*. Next.js uses this only for its local dev proxy.
API_INTERNAL_BASE_URL=http://localhost:8080
# Optional override for deployments that intentionally expose API on another origin.
NEXT_PUBLIC_API_BASE_URL=

# Restore is destructive and requires explicit per-run values; keep these empty by default.
RESTORE_DIR=
RESTORE_CONFIRM=
RESTORE_ALLOW_NONEMPTY=no
