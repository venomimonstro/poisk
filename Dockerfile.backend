FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/poisk ./cmd/app

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/poisk /app/poisk
COPY db/migrations /app/db/migrations
COPY docs/quality /app/docs/quality
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/app/poisk"]
CMD ["api"]
